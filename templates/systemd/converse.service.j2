[Unit]
Description=Converse ({{ converse_identifier }})
{% for service in converse_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in converse_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ converse_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ converse_identifier }} \
      --log-driver=none \
      --user={{ converse_uid }}:{{ converse_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ converse_container_network }} \
      {% if converse_container_http_host_bind_port %}
      -p {{ converse_container_http_host_bind_port }}:{{ converse_container_http_port }} \
      {% endif %}
      --env-file={{ converse_base_path }}/env \
      --label-file={{ converse_base_path }}/labels \
      {% for volume in converse_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for arg in converse_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ converse_container_image_self_build_name }} \
      {% for arg in converse_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% for network in converse_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ converse_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ converse_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ converse_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ converse_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ converse_identifier }}

[Install]
WantedBy=multi-user.target
