<!doctype html>
<html class="no-js" lang="en">
<head>
    <title>Converse</title>
    <meta charset="utf-8"/>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="Converse XMPP/Jabber Chat"/>
    <meta name="author" content="JC Brand" />
    <meta name="keywords" content="xmpp chat webchat converse.js" />
    <link rel="shortcut icon" type="image/ico" href="./dist/images/favicon.ico"/>
    {% if converse_analytics_enabled %}
    <script type="text/javascript" src="inverse-analytics.js"></script>
    <noscript><p><img src="//stats.opkode.com/piwik.php?idsite=5" style="border:0;" alt="" /></p></noscript>
    {% endif %}
    <link rel="manifest" href="./manifest.json">
    <link type="text/css" rel="stylesheet" media="screen" href="./dist/converse.min.css" />
    <style>.brand-heading { pointer-events: none; }</style>
    <script src="./3rdparty/libsignal-protocol.min.js"></script>
    <script src="./dist/converse.min.js"></script>
</head>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Converse",
  "description": "Open source XMPP chat client for the web",
  "url": "https://conversejs.org",
  "applicationCategory": "CommunicationApplication",
  "operatingSystem": "Web Browser",
}
</script>
<body class="converse-fullscreen">
<noscript>You need to enable JavaScript to run the Converse.js chat app.</noscript>
<div id="conversejs-bg"></div>
<script>
    converse.initialize({
        {% if converse_config_initialize_custom_enabled %}
            {{ converse_config_initialize_custom }}
        {% else %}
            theme: '{{ converse_config_initialize_theme }}',
            authentication: '{{ converse_config_initialize_authentication }}',
            auto_away: {{ converse_config_initialize_auto_away }},
            auto_reconnect: {{ converse_config_initialize_auto_reconnect | to_json }},
            bosh_service_url: '{{ converse_config_initialize_bosh_service_url }}',
            dark_theme: '{{ converse_config_initialize_dark_theme }}',
            loglevel: '{{ converse_config_initialize_loglevel }}',
            message_archiving: '{{ converse_config_initialize_message_archiving }}',
            omemo_default: {{ converse_config_initialize_omemo_default | to_json }},
            play_sounds: {{ converse_config_initialize_play_sounds | to_json }},
            view_mode: '{{ converse_config_initialize_view_mode }}',
            websocket_url: '{{ converse_config_initialize_websocket_url }}',
            show_background: {{ converse_config_initialize_show_background | to_json }},
            {{ converse_config_initialize_custom }}
        {% endif %}
    });
</script>
</body>
</html>
