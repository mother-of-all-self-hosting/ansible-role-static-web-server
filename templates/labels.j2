{% if static_web_server_container_labels_traefik_enabled %}
traefik.enable=true

{% if static_web_server_container_labels_traefik_docker_network %}
traefik.docker.network={{ static_web_server_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if static_web_server_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [static_web_server_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ static_web_server_identifier }}-basic-auth.basicauth.users={{ static_web_server_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if static_web_server_container_labels_traefik_path_prefix != '/' %}
{#
    redirectregex.regex without a leading caret (^) is intentional.
#}
traefik.http.middlewares.{{ static_web_server_identifier }}-slashless-redirect.redirectregex.regex=({{ static_web_server_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ static_web_server_identifier }}-slashless-redirect.redirectregex.replacement=$1/
{% set middlewares = middlewares + [static_web_server_identifier + '-slashless-redirect'] %}
{% endif %}

{% if static_web_server_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ static_web_server_identifier }}-strip-prefix.stripprefix.prefixes={{ static_web_server_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [static_web_server_identifier + '-strip-prefix'] %}
{% endif %}

{% if static_web_server_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in static_web_server_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ static_web_server_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [static_web_server_identifier + '-add-request-headers'] %}
{% endif %}

{% if static_web_server_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in static_web_server_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ static_web_server_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [static_web_server_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ static_web_server_identifier }}.rule={{ static_web_server_container_labels_traefik_rule }}
{% if static_web_server_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ static_web_server_identifier }}.priority={{ static_web_server_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ static_web_server_identifier }}.service={{ static_web_server_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ static_web_server_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ static_web_server_identifier }}.entrypoints={{ static_web_server_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ static_web_server_identifier }}.tls={{ static_web_server_container_labels_traefik_tls | to_json }}
{% if static_web_server_container_labels_traefik_tls %}
traefik.http.routers.{{ static_web_server_identifier }}.tls.certResolver={{ static_web_server_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ static_web_server_identifier }}.loadbalancer.server.port={{ static_web_server_container_http_port }}
{% endif %}

{% for arg in static_web_server_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
